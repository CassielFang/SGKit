<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GameScripts</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time reference only to the engine's managed API. Private=false:
         SGKit.Managed.dll is already loaded into the host, so don't ship a copy.
         Path is relative to this file: examples/ScriptExample/scripts -> repo root. -->
    <ProjectReference Include="..\..\..\managed\SGKit.Managed.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
